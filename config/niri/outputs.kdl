// Left Monitor (AOC 2476WM - #000888)
output "HDMI-A-3" {
    mode "1920x1080@60.000"
    position x=139 y=0
}

// Centre Monitor (ASUS PB287Q)
output "DP-5" {
    mode "2560x1440@59.951"
    position x=2059 y=0
    scale 1
}

// Right Monitor (AOC 2476WM - #001128)
output "HDMI-A-4" {
    mode "1920x1080@60.000"
    position x=4619 y=0
}

debug {
    render-drm-device "/dev/dri/by-path/pci-0000:00:02.0-card"
    //render-drm-device "/dev/dri/by-path/pci-0000:03:00.0-card"
    //render-drm-device "/dev/dri/card0"
}
