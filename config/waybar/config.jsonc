{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 6,

    // Define module order
    "modules-left": [
        "niri/workspaces", // Or "sway/workspaces" depending on your compositor
        "niri/window",
        "tray"

    ],
    "modules-right": [
        "custom/mpd-prev",
        "custom/mpd-toggle",
        "custom/mpd-next",
        "custom/mpd-song",
        "idle_inhibitor",
        "temperature",
        "memory",
        "network",
        "battery",
        "custom/microphone",
        "wireplumber", // Replaces pulseaudio natively
        "custom/vpn",
        "custom/date",
        "custom/clock-analog",
        "clock",
        "privacy"
    ],

    // --- Module Configurations ---
    "privacy": {
	"icon-size": 12
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": "",
            "urgent": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "custom/clock-analog": {
        "exec": "~/.scripts/analog-clock.sh",
        "interval": 1,
        "return-type": "json"
    },

    "custom/date": {
        "format": " {text} ",
        "exec": "date +'%d %b'",
        "interval": 1,
        "return-type": "text"
    },

    "clock": {
        "interval": 10,
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "mpd": {
        "server": "127.0.0.1",
        "port": 6600,
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) 󰎆",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "interval": 1,

        "consume-icons": {
            "on": "󰆪 "
        },
        "random-icons": {
            "off": "<span color=\"#a6e3a1\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },

        "on-click": "mpc toggle",
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },

    "custom/mpd-prev": {
        "format": "",
        "on-click": "mpc prev",
        "tooltip": false
    },

    "custom/mpd-toggle": {
        "format": "{text}",
        "exec": "mpc status | grep -q 'playing' && echo '' || echo ''",
        "interval": 1,
        "on-click": "mpc toggle",
        "tooltip": false
    },
    "custom/mpd-next": {
        "format": "",
        "on-click": "mpc next",
        "tooltip": false
    },


    "custom/mpd-song": {
        "format": "{text}",
        "exec": "$HOME/.scripts/mpd-zscroll",
        "escape": "true",
        "hide-empty-text": true
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 --%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "max-volume": 100,
        "scroll-step": 5
    },

    "custom/microphone": {
        "exec": "amixer get Capture | tail -2 | grep -q off && echo '' || echo ''",
        "interval": 1,
        "on-click": "$HOME/.scripts/toggle-mute.sh"
    },

    "custom/vpn": {
        "exec": "pgrep -x openvpn > /dev/null && echo '🖧 vpn' || echo ''",
        "interval": 5
    },

    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "interval": 1
    },

    "memory": {
        "interval": 1,
        "format": " {used:0.1f}G/{total:0.1f}G"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " +{capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 3
    },

    "network": {
        "interface": "wlan0",
        "format-wifi": "{icon}",
        "format-disconnected": "󰤯",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    }, 

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "timeout": 30.5
    }
}
}
