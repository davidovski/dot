#!/bin/sh

 230 │ ╭─▶     background-effect {
file="$HOME/.config/kaomoji"
selected=$(rofi -dmenu -i -display-columns 1 \
    -theme "$HOME/.config/rofi/kaomoji.rasi" < "$file") || exit 0

[ -n "$selected" ] || exit 0

tab=$(printf '\t')
kaomoji=${selected%%"$tab"*}

if [ -n "${WAYLAND_DISPLAY-}" ]; then
    wtype -d 20 "$kaomoji"
else
    xdotool type --clearmodifiers "$kaomoji"
fi

line=$(grep -n -F -x -e "$selected" "$file" | cut -d: -f1 | head -n 1)
f="$(sed "${line}d" $file)"
printf "%s\n%s" "$selected" "$f" > "$file"
