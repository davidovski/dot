[pos]
offsetx = 24
offsety = 24

[color]
bg = #191919
fg4= #f58d44
fg2 = #5f819d
fg3 = #707880
fg1 = #fefefe


[bar/base]
monitor = ${env:MONITOR}

enable-ipc                = true
font-0                    = FiraMono Nerd Font:style=Regular,size=10;3
font-1                    = MesloLGM Nerd Font Mono:style=Regular:pixelsize=14;3
font-2                    = Noto Sans Mono CJK TC:style=Medium,Regular;pixelsize=10;3

height                    = 32

module-margin		      = 1
wm-restack                = bspwm
radius                    = 0
background		          = ${color.bg}
border-size		          = 0
border-color              = ${color.fg3}
fg			              = ${color.fg1}
offset-y                  = 16

padding-right		      = 1

[bar/time]
inherit			          = bar/base
modules-center		      = time
width                     = 86

[bar/time1920]
inherit                   = bar/time
offset-x                  = 1792

[bar/time1080]
inherit                   = bar/time
offset-x                  = 952

[bar/time2560]
inherit                   = bar/time
offset-x                  = 2432

[bar/ws]
inherit                   = bar/base
width                     = 248
offset-x                  = 32
modules-left              = workspaces 
tray-position		      = right

[bar/right]
inherit                   = bar/base
width                     = 420
modules-center		      = temperature memory network battery pulseaudio vpn microphone
tray-position		      = right
padding                   = 1

[bar/right2560]
inherit                   = bar/right
offset-x                  = 1980

[bar/right1920]
inherit                   = bar/right
offset-x                  = 1340


[bar/mpd]
inherit                   = bar/base
width                     = 250
fixed-center              = true
modules-right		      = mpdctrls
modules-left		      = mpdsong
padding		              = 1

[bar/mpd2560]
inherit                   = bar/mpd
offset-x                  = 1698

[bar/mpd1920]
inherit                   = bar/mpd
offset-x                  = 1058

[module/xwindow]
type                      = internal/xwindow
label                     = %title:0:80:%

[module/workspaces]
type = internal/xworkspaces

pin-workspaces = true

enable-click = true
enable-scroll = true

format = <label-state>
label-monitor             = %name%
label-active              = %{T2}%{T-}
label-active-padding      = 1
label-occupied            = %{T2}%{T-}
label-occupied-padding    = 1
label-empty               = %{T2}%{T-}
label-empty-padding       = 1
label-urgent              = %{T2}%{T-}
label-urgent-padding      = 1


[module/time]
type                      = internal/date
interval                  = 10
time                      = "%H:%M"
date                      = "%d %b"
label                     = %{T2}%{T-} %time%
label-padding             = 0

[module/mpdctrls]
type                      = internal/mpd
host                      = 127.0.0.1
port                      = 6600
format-online 		      = <icon-prev> <toggle> <icon-next> 

icon-play		  = 
icon-pause 		  = 
icon-prev		  = 
icon-next		  = 

[module/mpdprogress]
type                      = internal/mpd
host                      = 127.0.0.1
port                      = 6600

format-online 		      = <bar-progress>

bar-progress-width = 13
bar-progress-indicator = |
bar-progress-fill = ─
bar-progress-empty = ─

format-online-padding     = 0

format-offline-padding    = 0

bar-empty         = ─

[module/mpdsong]
type                      = custom/script
exec                      = ~/.scripts/mpd-zscroll
tail                      = true
interval                  = 0.3


[module/pulseaudio]
type                      = internal/pulseaudio

format-volume             = %{T3}<ramp-volume>%{T-} <label-volume>
label-volume              = %percentage:3:3%%
use-ui-max                = false
interval                  = 3

ramp-volume-0             = "󰕿"
ramp-volume-1             = "󰖀"
ramp-volume-2             = "󰕾"

label-muted               = "%{T3}󰝟 %{T-}--%"

[module/microphone]
type = custom/script
exec = amixer get Capture | tail -2 | grep -q off && echo " " || echo " "
interval = 1
click-left = $HOME/.scripts/toggle-mute.sh

[module/vpn]
type = custom/script
exec = echo vpn
exec-if = pgrep -x openvpn
interval = 5
format-underline = #268bd2
format-prefix = "🖧 "
format-prefix-foreground = #5b

[module/temperature]
type = custom/script
exec = sensors | awk '/^Package id 0:/ { print substr($4, 2) }'
format-prefix = " "
interval = 1

[module/memory]
type = custom/script
exec = free -h | awk '/^Mem:/ {print $3 "/" $2}'
interval = 1
format-prefix = "力 "

[module/battery]
type = internal/battery
full-at = 99
battery = BAT0
adapter = AC

poll-interval = 3
time-format = %H:%M

format-charging = <animation-charging> <label-charging>
format-discharging = <ramp-capacity> <label-discharging>

label-charging = +%percentage%%
label-discharging = %percentage%%
label-full = %percentage%%

ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 

animation-charging-0 = 
animation-charging-1 = 
animation-charging-2 = 
animation-charging-3 = 
animation-charging-4 = 
animation-charging-framerate = 750

[module/network]
type = internal/network
interface = wlan0
udspeed-minwidth = 5
accumulate-stats = true
unknown-as-up = true
format-connected = <ramp-signal>
format-disconnected = <label-disconnected>

format-packetloss = 󰤫

ramp-signal-0 = 󰤯
ramp-signal-1 = 󰤟
ramp-signal-2 = 󰤢
ramp-signal-3 = 󰤥
ramp-signal-4 = 󰤨

label-disconnected = 󰤯

