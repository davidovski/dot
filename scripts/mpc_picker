#!/usr/bin/dash

# ugh just use the  cybolic's script instead of this mess lol
# https://git.sr.ht/~cybolic/nix-system/blob/main/packages/scripts/rofi/scripts/mpd-search.sh
exec $HOME/.scripts/mpd-search.sh track


format="%title%@%artist%@%album%@%file%"

columns="$(mpc -f "$format" listall \
    | column -t -s'@' \
        -C title,width=10,trunc \
        -C artist,width=10,trunc \
        -C album,width=10,trunc \
        -C file \
    | sed 's/&/&amp;/g'
)"

np=$(printf "%s" "$columns" | grep "$(mpc -f '%title%' current)" | head -1)
echo "$np"
selected=$(
        printf "%s" "$columns" | rofi -dmenu -i \
                -multi-select \
                -p " " \
                -ballot-selected-str " " \
                -ballot-unselected-str "  " \
                -select "$np"
    )
[ -z "$selected" ] && exit
echo "$selected" | while read -r option; do 
    file=$(printf "%s\n" "$option" | awk -F'  ' '{print $NF}' | sed 's/^\s*//g' | sed 's/\&amp;/\&/g')
    echo ${file}
    mpc insert "$file"
done
